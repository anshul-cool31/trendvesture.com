---
import ArticleCard from './ArticleCard.astro';
import { slugify } from '../utils/categories.js';

interface Props {
  title: string;
  categorySlug?: string;
  posts: Array<any>;
  layout?: 'grid-list' | 'overlay-list';
}

const { title, categorySlug = slugify(title), posts, layout = 'grid-list' } = Astro.props;

const mainPosts = posts.slice(0, layout === 'overlay-list' ? 1 : 2);
const secondaryPosts = layout === 'overlay-list' ? posts.slice(1, 3) : [];
const rightPosts = layout === 'overlay-list' ? posts.slice(3, 6) : posts.slice(2, 5);
---

<section class="category-block-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{title}</h2>
      <a href={`/category/${categorySlug}/`} class="section-view-all">
        <span>View All</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>

    <div class="category-block-grid">
      <!-- Left Column (66%) -->
      <div class="category-left-col">
        {layout === 'overlay-list' ? (
          <div class="overlay-layout-wrap">
            {mainPosts[0] && (
              <div class="overlay-main-item">
                <ArticleCard post={mainPosts[0]} variant="overlay" />
              </div>
            )}
            <div class="overlay-sub-items">
              {secondaryPosts.map(p => (
                <ArticleCard post={p} variant="grid" />
              ))}
            </div>
          </div>
        ) : (
          <div class="standard-2grid">
            {mainPosts.map(p => (
              <ArticleCard post={p} variant="grid" />
            ))}
          </div>
        )}
      </div>

      <!-- Right Column (33%) Stacked List -->
      <div class="category-right-col">
        <div class="horizontal-list">
          {rightPosts.map(p => (
            <ArticleCard post={p} variant="horizontal" />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .category-block-section {
    padding: 40px 0;
  }

  .category-block-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 36px;
  }

  .standard-2grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .overlay-layout-wrap {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 24px;
  }

  .overlay-sub-items {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .horizontal-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: 100%;
    justify-content: space-between;
  }

  @media (max-width: 960px) {
    .category-block-grid {
      grid-template-columns: 1fr;
    }
    .overlay-layout-wrap {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .standard-2grid {
      grid-template-columns: 1fr;
    }
  }
</style>
