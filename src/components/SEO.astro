---
import { siteConfig } from '../data/site.js';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    author: string;
    section: string;
    tags: string[];
  };
  author?: {
    name: string;
    bio: string;
    avatar: string;
    social: Record<string, string>;
  };
  canonicalUrl?: string;
  type?: 'website' | 'article' | 'profile';
}

const {
  title,
  description = siteConfig.description,
  image = siteConfig.defaultOgImage,
  article,
  author,
  canonicalUrl = Astro.url.href,
  type = 'website'
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.title;
const imageUrl = new URL(image, siteConfig.url).toString();
const canonical = new URL(canonicalUrl, siteConfig.url).toString();

// Generate JSON-LD Structured Data
const schemas = [];

// Organization & WebSite Schema
schemas.push({
  "@context": "https://schema.org",
  "@type": "NewsMediaOrganization",
  "name": siteConfig.name,
  "url": siteConfig.url,
  "logo": {
    "@type": "ImageObject",
    "url": new URL("/favicon.svg", siteConfig.url).toString()
  },
  "sameAs": Object.values(siteConfig.social)
});

schemas.push({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteConfig.name,
  "url": siteConfig.url,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteConfig.url}/search/?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
});

// BlogPosting Schema
if (type === 'article' && article) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonical
    },
    "headline": title,
    "description": description,
    "image": [imageUrl],
    "datePublished": article.publishedTime,
    "dateModified": article.modifiedTime || article.publishedTime,
    "author": {
      "@type": "Person",
      "name": article.author,
      "url": `${siteConfig.url}/author/${article.author.toLowerCase()}/`
    },
    "publisher": {
      "@type": "Organization",
      "name": siteConfig.name,
      "logo": {
        "@type": "ImageObject",
        "url": new URL("/favicon.svg", siteConfig.url).toString()
      }
    },
    "articleSection": article.section,
    "keywords": article.tags.join(", ")
  });
}

// Person Schema (Author Profile)
if (type === 'profile' && author) {
  schemas.push({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": author.name,
    "description": author.bio,
    "image": new URL(author.avatar, siteConfig.url).toString(),
    "sameAs": Object.values(author.social)
  });
}
---

<!-- Essential Meta Tags -->
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={siteConfig.locale} />

{type === 'article' && article && (
  <>
    <meta property="article:published_time" content={article.publishedTime} />
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    <meta property="article:author" content={article.author} />
    <meta property="article:section" content={article.section} />
    {article.tags.map(tag => (
      <meta property="article:tag" content={tag} />
    ))}
  </>
)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@trendvesture" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<!-- RSS Feed Discovery -->
<link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS Feed`} href="/feed.xml" />

<!-- Structured Data (JSON-LD) -->
{schemas.map(schema => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

