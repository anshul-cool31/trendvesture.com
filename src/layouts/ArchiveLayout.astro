---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Sidebar from '../components/Sidebar.astro';
import Pagination from '../components/Pagination.astro';

interface Props {
  title: string;
  description: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
  subcategories?: Array<{ name: string; slug: string }>;
  activeSubcategory?: string;
  categoryBaseUrl?: string;
  posts: Array<any>;
  allPosts: Array<any>;
  currentPage?: number;
  totalPages?: number;
  baseUrl: string;
  authorData?: any;
}

const {
  title,
  description,
  breadcrumbs,
  subcategories = [],
  activeSubcategory,
  categoryBaseUrl,
  posts,
  allPosts,
  currentPage = 1,
  totalPages = 1,
  baseUrl,
  authorData
} = Astro.props;
---

<BaseLayout 
  title={title} 
  description={description}
  type={authorData ? 'profile' : 'website'}
  author={authorData}
>
  <div class="archive-page">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <!-- Archive Header Banner -->
      <header class="archive-header-banner">
        {authorData ? (
          <div class="author-archive-header">
            <img src={authorData.avatar} alt={authorData.name} class="author-archive-avatar" />
            <div>
              <span class="archive-badge">Editorial Author</span>
              <h1 class="archive-title">{authorData.name}</h1>
              <p class="author-archive-role">{authorData.designation}</p>
              <p class="archive-description">{authorData.bio}</p>
              <div class="author-archive-socials">
                {authorData.social.instagram && (
                  <a href={authorData.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
                )}
                {authorData.social.twitter && (
                  <a href={authorData.social.twitter} target="_blank" rel="noopener noreferrer">Twitter / X</a>
                )}
                {authorData.social.linkedin && (
                  <a href={authorData.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
                )}
              </div>
            </div>
          </div>
        ) : (
          <div class="standard-archive-header">
            <span class="archive-badge">Archive Section</span>
            <h1 class="archive-title">{title}</h1>
            <p class="archive-description">{description}</p>
          </div>
        )}

        <!-- Subcategory Navigation Pills (if in a primary category) -->
        {subcategories.length > 0 && categoryBaseUrl && (
          <div class="subcategory-pills-bar">
            <a 
              href={categoryBaseUrl} 
              class={`subcat-pill ${!activeSubcategory ? 'active' : ''}`}
            >
              All {title}
            </a>
            {subcategories.map(sub => (
              <a 
                href={`${categoryBaseUrl}${sub.slug}/`} 
                class={`subcat-pill ${activeSubcategory === sub.slug ? 'active' : ''}`}
              >
                {sub.name}
              </a>
            ))}
          </div>
        )}
      </header>

      <!-- Main Grid with Sidebar -->
      <div class="content-with-sidebar">
        <div class="archive-feed-column">
          <div class="archive-feed-meta">
            <span>Showing {posts.length} {posts.length === 1 ? 'article' : 'articles'}</span>
          </div>

          <div class="archive-articles-grid">
            {posts.map(post => (
              <ArticleCard post={post} variant="grid" showExcerpt={true} />
            ))}
          </div>

          <Pagination 
            currentPage={currentPage} 
            totalPages={totalPages} 
            baseUrl={baseUrl} 
          />
        </div>

        <Sidebar popularPosts={allPosts} />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .archive-page {
    padding: 32px 0 64px 0;
  }

  .archive-header-banner {
    padding: 40px;
    background: var(--bg-surface);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-md);
    margin-bottom: 48px;
  }

  .archive-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .archive-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
    margin-bottom: 14px;
  }

  .archive-description {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 820px;
  }

  /* Author Header */
  .author-archive-header {
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }

  .author-archive-avatar {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 4px solid var(--bg-card);
    box-shadow: var(--shadow-md);
  }

  .author-archive-role {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .author-archive-socials {
    display: flex;
    gap: 16px;
    margin-top: 16px;
  }

  .author-archive-socials a {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .author-archive-socials a:hover {
    color: var(--accent);
  }

  /* Subcategory Pills */
  .subcategory-pills-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--border-medium);
  }

  .subcat-pill {
    padding: 6px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .subcat-pill:hover,
  .subcat-pill.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
  }

  /* Grid */
  .archive-feed-meta {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 24px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .archive-articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  @media (max-width: 768px) {
    .author-archive-header {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .archive-header-banner {
      padding: 24px;
    }
    .archive-articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

