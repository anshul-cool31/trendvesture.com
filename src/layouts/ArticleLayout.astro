---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AuthorBox from '../components/AuthorBox.astro';
import SocialShare from '../components/SocialShare.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import Sidebar from '../components/Sidebar.astro';
import { slugify } from '../utils/categories.js';
import { getReadingTime } from '../utils/reading-time.js';

interface Props {
  post: any;
  allPosts: any[];
  relatedPosts: any[];
  prevPost?: any;
  nextPost?: any;
}

const { post, allPosts, relatedPosts, prevPost, nextPost } = Astro.props;
const { data, body } = post;

const readingTime = getReadingTime(body);
const categorySlug = slugify(data.category);
const subcategorySlug = data.subcategory ? slugify(data.subcategory) : null;
const authorSlug = slugify(data.author);

const formattedDate = new Date(data.pubDate).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
});

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: data.category, href: `/category/${categorySlug}/` }
];

if (data.subcategory && subcategorySlug) {
  breadcrumbs.push({
    label: data.subcategory,
    href: `/category/${categorySlug}/${subcategorySlug}/`
  });
}

breadcrumbs.push({ label: data.title });

const articleSeo = {
  publishedTime: data.pubDate.toISOString(),
  modifiedTime: data.updatedDate ? data.updatedDate.toISOString() : undefined,
  author: data.author,
  section: data.category,
  tags: data.tags || []
};
---

<BaseLayout
  title={data.seoTitle || data.title}
  description={data.seoDescription || data.description}
  image={data.heroImage}
  article={articleSeo}
  type="article"
>
  <article class="single-article-page">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <!-- Article Header -->
      <header class="article-header">
        <a href={`/category/${categorySlug}/`} class="article-category-badge">
          {data.category}
        </a>

        <h1 class="article-title">{data.title}</h1>

        <div class="article-meta">
          <div class="article-meta-author">
            By <a href={`/author/${authorSlug}/`}>{data.author}</a>
          </div>
          <span class="article-meta-separator">•</span>
          <time datetime={data.pubDate.toISOString()}>{formattedDate}</time>
          <span class="article-meta-separator">•</span>
          <span class="article-reading-time">{readingTime}</span>
        </div>
      </header>

      <!-- Post Format Presentations -->
      {data.postFormat === 'standard' && (
        <figure class="article-hero-media">
          <img src={data.heroImage} alt={data.heroImageAlt || data.title} />
          {data.heroImageAlt && <figcaption class="article-hero-caption">{data.heroImageAlt}</figcaption>}
        </figure>
      )}

      {data.postFormat === 'gallery' && (
        <div class="article-format-gallery">
          <figure class="article-hero-media">
            <img src={data.heroImage} alt={data.heroImageAlt || data.title} />
          </figure>
          {data.galleryImages && data.galleryImages.length > 0 && (
            <div class="format-gallery-grid">
              {data.galleryImages.map((img: string, i: number) => (
                <div class="format-gallery-item">
                  <img src={img} alt={`Gallery look ${i + 1}`} loading="lazy" />
                </div>
              ))}
            </div>
          )}
        </div>
      )}

      {data.postFormat === 'quote' && (
        <div>
          <div class="format-quote-box">
            <p class="format-quote-text">“{data.quoteText || data.description}”</p>
            {data.quoteAuthor && <p class="format-quote-author">— {data.quoteAuthor}</p>}
          </div>
          <figure class="article-hero-media">
            <img src={data.heroImage} alt={data.heroImageAlt || data.title} />
          </figure>
        </div>
      )}

      {data.postFormat === 'video' && (
        <div>
          <div class="format-video-wrapper">
            <iframe 
              src="https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ" 
              title={data.title}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen
            ></iframe>
          </div>
        </div>
      )}

      {data.postFormat === 'audio' && (
        <div>
          <figure class="article-hero-media">
            <img src={data.heroImage} alt={data.heroImageAlt || data.title} />
          </figure>
          <div class="format-audio-player">
            <p style="font-weight: 700; margin-bottom: 8px;">Listen to this Editorial Episode:</p>
            <audio controls style="width: 100%;">
              <source src={data.audioUrl || "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3"} type="audio/mpeg" />
              Your browser does not support the audio element.
            </audio>
          </div>
        </div>
      )}

      {data.postFormat === 'image' && (
        <figure class="article-hero-media">
          <img src={data.heroImage} alt={data.heroImageAlt || data.title} />
          <figcaption class="article-hero-caption">High-Resolution Fashion Lookbook Photography</figcaption>
        </figure>
      )}

      {data.postFormat === 'link' && (
        <div>
          <figure class="article-hero-media">
            <img src={data.heroImage} alt={data.heroImageAlt || data.title} />
          </figure>
          {data.linkUrl && (
            <div style="background: var(--bg-surface); padding: 20px; border-radius: 8px; margin-bottom: 30px; display: flex; align-items: center; justify-content: space-between; border: 1px solid var(--border-medium);">
              <div>
                <span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--accent);">Curated Link Out</span>
                <p style="font-weight: 700; margin-top: 4px;">{data.title}</p>
              </div>
              <a href={data.linkUrl} target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: var(--accent); color: #fff; border-radius: 9999px; font-weight: 700; font-size: 0.8rem;">
                Visit Resource
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              </a>
            </div>
          )}
        </div>
      )}

      <!-- Main Body + Sidebar Grid -->
      <div class="content-with-sidebar">
        <!-- Main Article Content -->
        <div class="article-main-column">
          <div class="article-prose">
            <slot />
          </div>

          <!-- Tags -->
          {data.tags && data.tags.length > 0 && (
            <div class="article-tags-wrap">
              <span class="tags-label">Tagged:</span>
              {data.tags.map((tag: string) => (
                <a href={`/tags/${slugify(tag)}/`} class="article-tag-pill">
                  #{tag}
                </a>
              ))}
            </div>
          )}

          <!-- Social Share Bar -->
          <SocialShare title={data.title} url={Astro.url.href} />

          <!-- Prev / Next Post Navigation -->
          <nav class="post-navigation-grid" aria-label="Previous and Next Articles">
            {prevPost ? (
              <a href={`/posts/${prevPost.slug}/`} class="post-nav-card prev">
                <span class="post-nav-label">← Previous Story</span>
                <span class="post-nav-title">{prevPost.data.title}</span>
              </a>
            ) : <div />}

            {nextPost && (
              <a href={`/posts/${nextPost.slug}/`} class="post-nav-card next">
                <span class="post-nav-label">Next Story →</span>
                <span class="post-nav-title">{nextPost.data.title}</span>
              </a>
            )}
          </nav>

          <!-- Author Biography Box -->
          <AuthorBox authorName={data.author} />

          <!-- Related Posts -->
          <RelatedPosts posts={relatedPosts} />
        </div>

        <!-- Sidebar -->
        <Sidebar popularPosts={allPosts} authorId={data.author === 'Shivam' ? 'shivam' : 'tanisha'} />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .single-article-page {
    padding: 32px 0 64px 0;
  }

  .article-tags-wrap {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border-light);
  }

  .tags-label {
    font-weight: 700;
    font-size: 0.8125rem;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .article-tag-pill {
    padding: 4px 12px;
    background: var(--bg-surface);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .article-tag-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .post-navigation-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 40px 0;
  }

  .post-nav-card {
    display: flex;
    flex-direction: column;
    padding: 20px;
    background: var(--bg-surface);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .post-nav-card.next {
    text-align: right;
  }

  .post-nav-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .post-nav-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 6px;
  }

  .post-nav-title {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
  }

  @media (max-width: 640px) {
    .post-navigation-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

