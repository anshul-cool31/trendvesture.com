---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getRelatedPosts } from '../../utils/related-posts.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

  const paths = [];

  posts.forEach((post, index) => {
    const props = {
      post,
      allPosts: posts,
      prevPost: index < posts.length - 1 ? posts[index + 1] : null,
      nextPost: index > 0 ? posts[index - 1] : null
    };

    // Primary route matching post.slug (e.g. /posts/category/post-title/)
    paths.push({
      params: { slug: post.slug },
      props
    });

    // Also support short route without directory prefix (e.g. /posts/post-title/)
    if (post.slug.includes('/')) {
      const shortSlug = post.slug.split('/').pop();
      paths.push({
        params: { slug: shortSlug },
        props
      });
    }
  });

  return paths;
}

const { post, allPosts, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();
const relatedPosts = getRelatedPosts(post, allPosts, 3);
---

<ArticleLayout
  post={post}
  allPosts={allPosts}
  relatedPosts={relatedPosts}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</ArticleLayout>

